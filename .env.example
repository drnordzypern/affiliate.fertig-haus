# Environment variable names only. No values. No credentials.
# Copy to .env.local and fill in only once a real integration is approved
# and configured — do not commit .env.local or any file with real values.
#
# Next.js does NOT expose server-only variables to the browser by default.
# Only variables prefixed with NEXT_PUBLIC_ are inlined into the client
# bundle at build time. Keep that prefix reserved for values that are
# genuinely safe to be public.

# Base URL of the SalesChain public/API boundary that the same-origin BFF
# will call. Server-only. The exact SalesChain authentication contract is
# not yet approved — do not configure this against a real environment.
SALESCHAIN_API_BASE_URL=

# Tentative placeholder name for whatever credential the BFF uses to
# authenticate to SalesChain. The SalesChain authentication contract is
# not yet approved, so this single variable is a guess at the eventual
# shape — it may need to become multiple variables (e.g. a client id and
# secret) once that contract is reviewed. Server-only — must never be read
# in a Client Component, never prefixed with NEXT_PUBLIC_, and never
# returned in any API response body. No real value should ever be
# committed here or anywhere in this repository.
SALESCHAIN_BFF_CREDENTIAL=

# Cloudflare Turnstile site key used to protect the future invitation
# acceptance and Partner application forms.
# This is a public, browser-visible key by design — that's why it carries
# the NEXT_PUBLIC_ prefix, unlike the two variables above.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
