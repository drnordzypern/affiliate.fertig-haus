# Environment variable names only. No values. No credentials.
# Copy to .env.local and fill in only with real, approved values — do not
# commit .env.local or any file with real values.
#
# Next.js does NOT expose server-only variables to the browser by default.
# Only variables prefixed with NEXT_PUBLIC_ are inlined into the client
# bundle at build time. Keep that prefix reserved for values that are
# genuinely safe to be public.

# Base URL of the SalesChain public/API boundary that the same-origin BFF
# calls (see app/api/partner-invitations/accept and
# app/api/partner-sessions/logout). Server-only — read only in
# lib/saleschain/config.ts. Must be an absolute https:// URL in Production;
# an explicit http://localhost URL is only permitted outside Production.
# The value must be an origin only: no credentials, path, query, or fragment.
# A trailing slash is accepted and normalized away.
SALESCHAIN_API_BASE_URL=

# Cloudflare Turnstile site key used to protect invitation acceptance.
# This is a public, browser-visible key by design — that's why it carries
# the NEXT_PUBLIC_ prefix. SalesChain performs the actual Turnstile
# verification server-side; the secret key never belongs in this repository.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
